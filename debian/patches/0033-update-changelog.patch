+
+    //2. xorrisoä¸ä¼šåˆ»å½•ç©ºçš„ç›®å½•ï¼Œæ‰€ä»¥åˆ›å»ºä¸€ä¸ªä¸´æ—¶æ–‡ä»¶
+    tmpFilePath = tmpDirPath + "/udf-tmp.txt";
+    tmpFile.setFileName(tmpFilePath);
+    if(!tmpFile.open(QIODevice::ReadWrite))             //å¦‚æžœæ–‡ä»¶ä¸å­˜åœ¨åˆ™ä¼šåˆ›å»ºæ–‡ä»¶
+        return false;
