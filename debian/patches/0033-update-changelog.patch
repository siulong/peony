+DiscControl::~DiscControl(){
+    if((nullptr!=mBlockInf) && mBlockInf->isValid())
+        delete mBlockInf;
+    if((nullptr!=mDriveInf) && mDriveInf->isValid())
+        delete mDriveInf;
+    if((nullptr!=mFilesystemInf) && mFilesystemInf->isValid())
+        delete mFilesystemInf;
