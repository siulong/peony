+
+    //4. åˆ»å½•ç»“æŸåŽåˆ é™¤ä¸´æ—¶ç›®å½•
+    tmpDir.removeRecursively();                        //åˆ é™¤ä¸´æ—¶ç›®å½•ä»¥åŠå†…éƒ¨çš„ä¸´æ—¶æ–‡ä»¶
+    return true;
+}
