+    // With ide-scsi there is no problem. But without the
+    // GPCMD_READ_DISC_INFO command failes if the size is 34
+    //
+
+/*     unsigned char reserved3; */
+/*     unsigned char opc_entries; */
+}disc_info_t;
+
+/*æ³¨é‡Šä¸ºå¼€å‘ä¸­è‡ªæµ‹çš„ç»“æžœï¼Œç»´æŠ¤è€…å¯æ›´æ–°*/
+enum MediaType{
+    MEDIA_UNKNOWN       = 0x1,
+    MEDIA_NONE          = 0x2,
+
+    /*DVD*/
+    MEDIA_DVD_ROM       = 0x4,      //ROMè¡¨ç¤ºåªè¯»
+    MEDIA_DVD_R         = 0x8,      //DVD-R
+    MEDIA_DVD_R_SEQ     = 0x10,     //å¯è¿½åŠ DVD-R
+    MEDIA_DVD_R_DL      = 0x20,     //åŒå±‚DVD-R
