+/** å¼‚æ­¥å¤„ç†å…‰ç›˜å¸è½½æ“ä½œçš„æ§½å‡½æ•°, æ‰§è¡Œå®ŒåŽå‘å°„unmountFinished(QString)ä¿¡å·
+ *  å¸è½½æˆåŠŸæ—¶ä¿¡å·å‚æ•°is empty
+ *  å¸è½½å¤±è´¥æ—¶ä¿¡å·å‚æ•°ä¸ºæŠ¥é”™ä¿¡æ¯
+*/
+void DiscControl::unmountSlot(QDBusPendingCallWatcher* watcher){
+    QString unmountError;
+    QDBusPendingReply<QDBusVariant> unmountReply = *watcher;
+    watcher->disconnect();      //æ–­å¼€è¯¥å¯¹è±¡æ‰€æœ‰ä¿¡å·ä¸Žå…¶ä»–å¯¹è±¡çš„æ§½å‡½æ•°è¿žæŽ¥
+    watcher->deleteLater();
+
+    if(unmountReply.isError())
+        unmountError = unmountReply.error().message();
+
+    if(unmountError.contains("Unexpected reply signature"))//æŠ¥æ­¤é”™æ—¶å®žé™…ä¸Šå¸è½½æˆåŠŸ
+        unmountError.clear();
+    else if(unmountError.contains("is not mounted"))       //å…‰ç›˜æ— éœ€å¸è½½
+        unmountError.clear();
+    else if(unmountError.contains("target is busy"))
+        unmountError = mDevice + tr(" is busy!");           //ç¿»è¯‘ï¼š"è¢«å…¶ä»–ç¨‹åºå ç”¨!"
+    else if(!unmountError.isEmpty())
+        qInfo()<<"["<<mDevice<<"]"<<unmountError;
+
+    Q_EMIT unmountFinished(unmountError);
+
+    /*test: æµ‹è¯•å¼‚æ­¥å…‰ç›˜åˆ»å½•æµç¨‹*/
+//    if(!unmountError.isEmpty())                             //å¸è½½æˆåŠŸæ‰å¯ä»¥åˆ»å½•
+//        discBurn("/home/yan/æ¡Œé¢/2.txt", "/", "");
+}
