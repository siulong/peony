+}
+
+bool DiscControl::work(){
+    //1. åˆå§‹åŒ–æˆå‘˜å˜é‡ã€æ£€æµ‹å…‰ç›˜æ˜¯å¦å‡†å¤‡å°±ç»ª
+    if(!workForInitMembers())
+        return false;               //å…‰ç›˜ä¸å­˜åœ¨æˆ–é‡è¦æˆå‘˜å˜é‡newå¤±è´¥æ—¶è¿”å›žfalse
+    //2. æ£€æµ‹æ˜¯å¦æ˜¯ç©ºç›˜
+    //workFromDrive();
+    //3. æ£€æµ‹ç›˜ç‰‡æ˜¯å¦å¯èƒ½å·²æŸå
+    //workFromFilesystem();
+    //4. æ£€æµ‹æ˜¯å¦å¯è¿½åŠ 
+    //workForAppend();
+    //5. å…·ä½“åŒ–å…‰ç›˜ç±»åž‹
+    //workForMediaType();
+    //6. èŽ·å–å…‰ç›˜æ–‡ä»¶ç³»ç»Ÿæ ¼å¼å’Œå·æ ‡
+    //workFromBlock();
+
