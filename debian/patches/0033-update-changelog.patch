+    MEDIA_DVD_RW        = 0x200,    //DVD-RW
+    MEDIA_DVD_RW_OVWR   = 0x400,
+    MEDIA_DVD_RW_SEQ    = 0x800,	//ä¸å¯è¿½åŠ çš„DVD-RW
+    MEDIA_DVD_PLUS_RW   = 0x1000,   //DVD+RW
+    MEDIA_DVD_PLUS_R    = 0x2000,	//DVD+R
+    MEDIA_DVD_PLUS_R_DL = 0x4000,	//åŒå±‚DVD+R
+    MEDIA_DVD_PLUS_RW_DL= 0x8000,	//åŒå±‚DVD+RW
+    MEDIA_DVD_R_ALL     = MEDIA_DVD_R | MEDIA_DVD_R_SEQ | MEDIA_DVD_R_DL |
+                          MEDIA_DVD_R_DL_SEQ | MEDIA_DVD_R_DL_JUMP,     //DVD-Ræ‰€æœ‰ 0xE8
+    MEDIA_DVD_PLUS_R_ALL= MEDIA_DVD_PLUS_R | MEDIA_DVD_PLUS_R_DL,             //DVD+Ræ‰€æœ‰
+    MEDIA_DVD_RW_ALL    = MEDIA_DVD_RW | MEDIA_DVD_RW_OVWR | MEDIA_DVD_RW_SEQ,//DVD-RWæ‰€æœ‰
+    MEDIA_DVD_PLUS_RW_ALL=MEDIA_DVD_PLUS_RW | MEDIA_DVD_PLUS_RW_DL,           //DVD+RWæ‰€æœ‰
+    MEDIA_DVD_ALL       = MEDIA_DVD_R_ALL | MEDIA_DVD_PLUS_R_ALL | MEDIA_DVD_RW_ALL |
+                          MEDIA_DVD_PLUS_RW_ALL | MEDIA_DVD_ROM | MEDIA_DVD_RAM, //DVDæ‰€æœ‰
+
+    /*CD*/
+    MEDIA_CD_ROM        = 0x10000,  //åªè¯»CD
+    MEDIA_CD_R          = 0x20000,
+    MEDIA_CD_RW         = 0x40000,
+    MEDIA_WRITEABLE_CD  = MEDIA_CD_R | MEDIA_CD_RW,
+    MEDIA_CD_ALL        = MEDIA_WRITEABLE_CD | MEDIA_CD_ROM,
+
+    //MEDIA_WRITEABLE_DVD_DL
+
+    /*HD*/
+    MEDIA_HD_DVD_ROM    = 0x80000,  //åªè¯»HD-DVD
+    MEDIA_HD_DVD_R      = 0x100000,
+    MEDIA_HD_DVD_RAM    = 0x200000,
+    /*BD*/
+};
