+
+    //3. åˆ»å½•æ“ä½œï¼šå°†ç©ºç›˜å˜ä¸ºéžç©ºç›˜
+    tmpBurnArg<<"-dev"<<mDevice<<"-map"<<tmpDirPath<<"/"<<"-close"<<"off"<<"-commit";
+    tmpBurn.start("xorriso", tmpBurnArg);
