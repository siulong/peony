+DiscCommand::DiscCommand(QObject *parent) : QObject(parent)
+{
+    initMembers();
+}
+
+DiscCommand::~DiscCommand(){
+    if(mProcess){
+        mProcess->disconnect(); //æ–­å¼€mProcessæ‰€æœ‰çš„ä¿¡å·æ§½è¿žæŽ¥
+        //delete mProcess;
+        mProcess->deleteLater();
+    }
+}
+
+void DiscCommand::initMembers(){
+    mSuccess = false;
+    mProcess = new QProcess;
+}
+
+/** å‘½ä»¤æ‰§è¡Œç»“æŸæ§½å‡½æ•° */
+void DiscCommand::cmdFinishSlot(int exitCode, QProcess::ExitStatus exitStatus){
+    qInfo()<<__func__<<__LINE__<<mSuccess<<mFinishedInfo;
+    if(QProcess::NormalExit != exitStatus)
+        qInfo()<<mProcess->errorString();
+
+    if(mSuccess)
+        mFinishedInfo.clear();
+
+    Q_EMIT cmdFinished(mFinishedInfo);  //å‘å°„ä¿¡å·é€šçŸ¥å…¶ä»–åœ°æ–¹å‘½ä»¤æ‰§è¡Œå®Œæˆ
+}
+
+void DiscCommand::readOutputSlot(){
+    QString preOutputContents = mProcess->readAllStandardOutput();
+    qInfo()<<preOutputContents;
+//    if(preOutputContents.contains("completed successfully")){    //åˆ»å½•æˆåŠŸ
+//        mSuccess = true;
+//        //mProcess->disconnect(SIGNAL(readyStandardOutput()));     //æ–­å¼€QProcessçš„ä¿¡å·è¿žæŽ¥
+//    }else if(preOutputContents.contains("cancel its operation")){  //å–æ¶ˆäº†åˆ»å½•æ“ä½œ
+//        mSuccess = false;
+//        mFinishedInfo = QObject::tr("burn operation has been cancelled"); //ç¿»è¯‘ï¼šåˆ»å½•æ“ä½œå·²å–æ¶ˆ
+//        //mProcess->disconnect(SIGNAL(readyStandardOutput()));     //æ–­å¼€QProcessçš„ä¿¡å·è¿žæŽ¥
+//    }else if(preOutputContents.contains("Device or resource busy")){
+//        mSuccess = false;
+//        mFinishedInfo = mProcess->arguments().at(1) + QObject::tr("is busy!");//ç¿»è¯‘ï¼šè¢«å ç”¨
+//    }
+}
+
+void DiscCommand::readErrorSlot(){
+    QString preErrorContents = mProcess->readAllStandardError();
+    qInfo()<<preErrorContents;
+    if(preErrorContents.contains("completed successfully")){    //åˆ»å½•æˆåŠŸ
+        mSuccess = true;
+        //mProcess->disconnect(SIGNAL(readyStandardOutput()));     //æ–­å¼€QProcessçš„ä¿¡å·è¿žæŽ¥
+    }else if(preErrorContents.contains("cancel its operation")){  //å–æ¶ˆäº†åˆ»å½•æ“ä½œ
+        mSuccess = false;
+        mFinishedInfo = QObject::tr("burn operation has been cancelled"); //ç¿»è¯‘ï¼šåˆ»å½•æ“ä½œå·²å–æ¶ˆ
+        //mProcess->disconnect(SIGNAL(readyStandardOutput()));     //æ–­å¼€QProcessçš„ä¿¡å·è¿žæŽ¥
+    }else if(preErrorContents.contains("Device or resource busy")){
+        mSuccess = false;
+        mFinishedInfo = mProcess->arguments().at(1) + QObject::tr(" is busy!");//ç¿»è¯‘ï¼šè¢«å ç”¨
+    }
+}
+
+/** è®¾ç½®å‘½ä»¤ä»¥åŠå‘½ä»¤å‚æ•° */
+void DiscCommand::setCmd(const QString& inputCmd, const QStringList& inputCmdParameters){
+    mCommand = inputCmd;
+    mProcess->setProgram(inputCmd);
+    mProcess->setArguments(inputCmdParameters);
+}
+
+/** å¼‚æ­¥æ‰§è¡Œlinuxå‘½ä»¤, å‘½ä»¤çš„è¾“å‡ºé€šè¿‡æ§½å‡½æ•°è¿›è¡Œæ•èŽ·
+*/
+void DiscCommand::startCmd(){
+    mProcess->setReadChannel(QProcess::StandardOutput);
+    connect(mProcess, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),this, &DiscCommand::cmdFinishSlot);
+    connect(mProcess, &QProcess::readyReadStandardOutput, this, &DiscCommand::readOutputSlot);
+    connect(mProcess, &QProcess::readyReadStandardError, this, &DiscCommand::readErrorSlot);
+    mProcess->start();
+}
+
+/** é˜»å¡žå¼æ‰§è¡Œlinuxå‘½ä»¤ï¼Œå‘½ä»¤é€€å‡ºåŽæ‰è¿”å›ž
+*/
+bool DiscCommand::startAndWaitCmd(QString& errorInfo){
+    mProcess->start();
+    /** FIXME: ä½¿ç”¨waitForFinished()æ— æ³•æ•èŽ·å‘½ä»¤åœ¨æ­£å¸¸æ‰§è¡Œè¿‡ç¨‹ä¸­çš„æŠ¥é”™ä¿¡æ¯
+     *  ä¹Ÿå³: æ— è®ºå‘½ä»¤æ‰§è¡Œè¿‡ç¨‹ä¸­æ˜¯å¦ä¼šæŠ¥é”™ï¼Œè¯¥å‡½æ•°æ°¸è¿œè¿”å›žtrue; é™¤éžå­˜åœ¨äººä¸ºkillæ“ä½œ
+    */
+    if(!mProcess->waitForFinished(-1)){
+        errorInfo = mProcess->errorString();
+        return false;
+    }
+    return true;
+}
