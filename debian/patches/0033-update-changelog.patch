+    //2. è¿›è¡Œå…‰ç›˜çš„å¸è½½æ“ä½œ
+    if(!discUnmountSync())  //å…‰ç›˜å¸è½½å¤±è´¥æ—¶æ— æ³•è¿›è¡Œåˆ»å½•æ“ä½œ
+        return false;
+
+    //3. ç¡¬é“¾æŽ¥åˆ›å»ºå®ŒæˆåŽï¼Œå¯¹ç›®å½•è¿›è¡Œé˜»å¡žå¼åˆ»å½•æ“ä½œ
+    burnCmd = "xorriso";
+    burnCmdParameters << "-dev" << mDevice << "-map" << willBurnDir << destDir;
