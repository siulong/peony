+/** åˆ»å½•æ–‡ä»¶å‰çš„å‡†å¤‡æ“ä½œï¼š
+ *  @srcFileæ˜¯æ–‡ä»¶æˆ–è€…è½¯è¿žæŽ¥ï¼Œåˆ™åœ¨æŒ‡å®šç›®å½•ä¸‹åˆ›å»ºç¡¬é“¾æŽ¥å¹¶è¿”å›ž
+ *  @srcFileæ˜¯ç›®å½•åˆ™ç›´æŽ¥è¿”å›žç›®å½•
+ *  note: @srcFileå¿…é¡»è¦æ˜¯ç»å¯¹è·¯å¾„
+ *  @return è¿”å›žç¡¬é“¾æŽ¥çš„çˆ¶ç›®å½• æˆ–è€…ç›´æŽ¥è¿”å›ž ä¼ å…¥çš„ç›®å½•
+*/
+QString DiscControl::prepareFileBeforeBurn(const QString& srcFile){
+    QFileInfo srcFileAttr;
+    QString realSrcFile;
+    QString needBurnDir;
+    if(srcFile.isEmpty())
+        return QString();
+
+    srcFileAttr.setFile(srcFile);
+    if(!srcFileAttr.exists())        //æ–‡ä»¶è·¯å¾„é”™è¯¯æˆ–æ–‡ä»¶ä¸å­˜åœ¨ï¼Œä¸äºˆåˆ»å½•
+        return QString();
+
+    if(srcFileAttr.isSymLink()){     //å¦‚æžœæ˜¯è½¯è¿žæŽ¥ï¼Œå…ˆèŽ·å–åˆ°åŽŸæ–‡ä»¶/åŽŸç›®å½•
+        realSrcFile = srcFileAttr.symLinkTarget();
+        srcFileAttr.setFile(realSrcFile);
+    }
+
+    //æ™®é€šæ–‡ä»¶éœ€è¦åˆ›å»ºç¡¬é“¾æŽ¥åŽå†å¯¹ç›®å½•è¿›è¡Œåˆ»å½•æ“ä½œ
+    if(srcFileAttr.isFile()){
+        QStringList hardLinkArgs;
+        QString hardLinkFileName;
+        QString hardLinkParentDir;
+        QDir dirObject;
+        //åˆ›å»ºåŒåç¡¬é“¾æŽ¥åˆ°æŒ‡å®šç›®å½•ä¸‹
+        QProcess *createHardlink = new QProcess();
+        hardLinkFileName = srcFileAttr.fileName();          //åŒåç¡¬é“¾æŽ¥
+        hardLinkParentDir = QDir::homePath()+"/.cache/KylinBurner/";
+	//hardLinkParentDir = srcFileAttr.canonicalPath(() + ".cache/KylinBurner";//æ±Ÿè¥¿é“¶è¡Œé¡¹ç›®ä¿®æ”¹ç¡¬é“¾æŽ¥è·¯å¾„
+        //å…ˆç¡®ä¿æŒ‡å®šç›®å½•å­˜åœ¨,ä¸å­˜åœ¨åˆ™é€’å½’åˆ›å»º
+        dirObject.setPath(hardLinkParentDir);
+        if(!dirObject.exists()){
+            if(!dirObject.mkpath(hardLinkParentDir)){
+                qInfo()<<"faild for mkdir:" + hardLinkParentDir;
+                return QString();
+            }
+        }
+        //é˜»å¡žå¼åˆ›å»ºæ–‡ä»¶çš„ç¡¬é“¾æŽ¥
+        hardLinkFileName = hardLinkParentDir+hardLinkFileName;
+        createHardlink->setProgram("ln");
+        hardLinkArgs.append(srcFileAttr.absoluteFilePath());//lnç¬¬ä¸€ä¸ªå‚æ•°
+        hardLinkArgs.append(hardLinkFileName);              //lnç¬¬äºŒä¸ªå‚æ•°
+        createHardlink->setArguments(hardLinkArgs);
+        createHardlink->start();
+        if(!createHardlink->waitForFinished(-1)){           //é˜»å¡žç­‰å¾…lnå‘½ä»¤æ‰§è¡Œ
+            qInfo()<<createHardlink->errorString();
+            createHardlink->deleteLater();
+            return QString();
+        }
+        createHardlink->deleteLater();
+        srcFileAttr.setFile(hardLinkFileName);
+        if(!srcFileAttr.exists()){                          //ç¡¬é“¾æŽ¥æ–‡ä»¶æœªæ‰¾åˆ°
+            qInfo()<<"create hardlink failed for"<<srcFile;
+            return QString();
+        }
+
+        return hardLinkFileName.mid(0,hardLinkFileName.lastIndexOf("/"));
+    }else{//ç›®å½•å¯ä»¥ç›´æŽ¥åˆ»å½•
+        needBurnDir = srcFileAttr.absoluteFilePath();
+        return needBurnDir;
+    }
+
+    return QString();
+}
