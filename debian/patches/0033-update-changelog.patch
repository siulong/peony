+bool DiscControl::discBurnSync(QString srcFile, QString destDir, const QString& discLabel,QString& burnError){
+    QString burnCmd;                //åˆ»å½•å‘½ä»¤
+    bool burnSuccess;               //åˆ»å½•æ˜¯å¦æˆåŠŸ
+    QString willBurnDir;            //éœ€è¦åˆ»å½•çš„æ–‡ä»¶å¤¹
+    QString burnErrorInfo;          //åˆ»å½•æŠ¥é”™ä¿¡æ¯
+    DiscCommand * burnOperation;
+    QStringList burnCmdParameters;  //åˆ»å½•å‘½ä»¤çš„å‚æ•°
+
+    //1. ç¡®å®šéœ€è¦åˆ»å½•çš„ç›®å½•å
+    willBurnDir = prepareFileBeforeBurn(srcFile);
+    if(willBurnDir.isEmpty())
+        return false;
