+bool FileLauchDialog::event(QEvent *event)
+{
+    //失去焦点即关闭窗口
+    if (event->type() == QEvent::ActivationChange) {
+        if (QApplication::activeWindow() != this) {
+            this->close();
+            return false;
+        }
+    }
+    return QWidget::event(event);
+}
