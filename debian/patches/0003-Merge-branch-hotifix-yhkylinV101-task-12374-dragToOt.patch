+                return;
+            this->setSelections(m_new_files_to_be_selected);
+            m_new_files_to_be_selected.clear();
+        });
+    } else {
+        if (!m_new_files_to_be_selected.contains(uri)) {
+            m_new_files_to_be_selected<<uri;
+        }
