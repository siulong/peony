+int PeonyDesktopApplication::checkScreenMode(const QRect &geometry)
+{
+    int mode = 1;
+    if (m_bg_windows.count() == 1) {
+        mode = 0;
+        return mode;
+    }
+
+    for (auto window : m_bg_windows) {
+        if (window->screen()->geometry() != geometry) {
+            mode = 2;
+            break;
+        }
+    }
+    return mode;
+}
 
