+TEST_F(FileItemModelTest, columnCount)
+{
+    /* 该函数用于验证列表视图页面列数（常规目录有四列，回收站有5列） */
+    fileItemModel->setRootUri("file:///home/kylin");
+    int columnCount = fileItemModel->columnCount(QModelIndex());
+    EXPECT_EQ(columnCount, 4);
