+//------------------------------------------------------------------------------
+inline uint32_t elf_hash( const unsigned char* name )
+{
+	uint32_t h = 0, g;
+	while ( *name ) {
+		h = ( h << 4 ) + *name++;
+		g = h & 0xf0000000;
+		if ( g != 0 )
+			h ^= g >> 24;
+		h &= ~g;
+	}
+	return h;
+}
