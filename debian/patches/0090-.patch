+
+Wrapper::Wrapper()
+{
+
+}
+
+Wrapper::~Wrapper()
+{
+
+}
+
+void freeWrapper(Wrapper *wrapper)
+{
+    if (!wrapper)
+        return;
+
+    for (auto iter = stub_wrappers.begin(); iter != stub_wrappers.end();) {
+        if (iter->second == wrapper)
+            iter = stub_wrappers.erase(iter);
+        else
+            ++iter;
+    }
+
+    delete wrapper;
+}
+}
