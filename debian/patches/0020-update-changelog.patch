+#include <QObject>
+#include <QUrl>
+
+class QRemoteObjectNode;
+class FileEventHandlerReplica;
+
+class RemoteFileEventHelper : public QObject
+{
+    Q_OBJECT
+public:
+    explicit RemoteFileEventHelper(QObject *parent = nullptr);
+    ~RemoteFileEventHelper();
+
+Q_SIGNALS:
