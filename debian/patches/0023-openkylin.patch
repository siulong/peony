note:
PlasmaShellManager中对于wayland平台的判断在openkylin上不准确，导致wayland下没有获取相关的接口句柄，修改平台判断的代码以适配wayland场景
---
 peony-qt-desktop/plasma-shell-manager.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/peony-qt-desktop/plasma-shell-manager.cpp b/peony-qt-desktop/plasma-shell-manager.cpp
index ef5e361..0745006 100644
--- a/peony-qt-desktop/plasma-shell-manager.cpp
+++ b/peony-qt-desktop/plasma-shell-manager.cpp
@@ -94,7 +94,7 @@ KWayland::Client::PlasmaShellSurface *PlasmaShellManager::createSurface(QWindow
 
 PlasmaShellManager::PlasmaShellManager(QObject *parent) : QObject(parent)
 {
-    if (QX11Info::isPlatformX11() || QString(qgetenv("QT_QPA_PLATFORM")) != "wayland" || !QString(qgetenv("XDG_SESSION_DESKTOP")).contains("ukui-wayland"))
+    if (QApplication::platformName().contains("wayland", Qt::CaseInsensitive));
         return;
     auto connection = KWayland::Client::ConnectionThread::fromApplication(qApp);
     auto registry = new KWayland::Client::Registry(this);
